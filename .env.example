# Copie para .env e ajuste. Não coloque tokens neste arquivo de exemplo.
# Imagem publicada no GitHub Container Registry e versão (SemVer, ex.: 0.1.0, ou latest).
IGNIS_IMAGE=ghcr.io/viniciuskanh/ignis-multimodal
IGNIS_TAG=latest
# Porta publicada SOMENTE em 127.0.0.1.
IGNIS_PORT=8000
# Pasta-base dos dados persistentes (models, datasets, training, outputs, logs, configs).
# "." reaproveita as pastas do projeto. Ex.: IGNIS_DATA_DIR=D:/ignis-data
IGNIS_DATA_DIR=.
# Usuário do container. Em Linux, use o seu UID/GID (id -u / id -g) para gravar nas pastas montadas.
IGNIS_UID=1000
IGNIS_GID=1000
# 1 = nunca acessar o Hugging Face Hub (somente modelos já instalados).
HF_HUB_OFFLINE=0
# Quantidade de GPUs reservadas em compose.gpu.yaml (1 ou all).
IGNIS_GPU_COUNT=1
